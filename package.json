{
  "name": "wtg-downdetector",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:worker",
    "build:worker": "esbuild src/worker/cli.ts --bundle --platform=node --format=cjs --external:@prisma/client --external:.prisma/client --outfile=dist/worker.cjs && esbuild prisma/seed.ts --bundle --platform=node --format=cjs --external:@prisma/client --external:.prisma/client --external:argon2 --outfile=dist/seed.cjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:integration": "vitest --config vitest.config.integration.ts",
    "test:e2e": "playwright test",
    "worker": "tsx src/worker/cli.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "argon2": "^0.41.1",
    "lucide-react": "^0.474.0",
    "next": "^15.1.8",
    "nodemailer": "^6.9.16",
    "pg": "^8.23.0",
    "prisma": "^6.19.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22",
    "@types/nodemailer": "^6.4.16",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "^15.1.8",
    "jsdom": "^26.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^3.0.5"
  }
}
